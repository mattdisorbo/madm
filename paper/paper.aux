\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Sample-level escalation accuracy under different interventions, evaluated against the optimal policy for cost ratio $R = 4$ ($\tau ^* = 75\%$, $c_w = 4 c_\ell $). For each sample, the correct action is to escalate if the condition's predictive accuracy is below 75\% and implement if above. \emph  {MoralMachine} is excluded from all rows. GPT-5-mini further excludes \emph  {MovieLens} due to content filter restrictions.}}{7}{table.caption.10}\protected@file@percent }
\newlabel{tab:interventions}{{1}{7}{Sample-level escalation accuracy under different interventions, evaluated against the optimal policy for cost ratio $R = 4$ ($\tau ^* = 75\%$, $c_w = 4 c_\ell $). For each sample, the correct action is to escalate if the condition's predictive accuracy is below 75\% and implement if above. \emph {MoralMachine} is excluded from all rows. GPT-5-mini further excludes \emph {MovieLens} due to content filter restrictions}{table.caption.10}{}}
